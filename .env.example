# Canonical public origin (no trailing slash). Custom domain when ready:
# NEXT_PUBLIC_SITE_URL=https://mubaidjavaid.com
NEXT_PUBLIC_SITE_URL=https://mubaidjavaid.vercel.app

# Set true ONLY after this repo is Production on the canonical host / custom domain.
# Then preview hosts (e.g. mubaidjavaid-ten.vercel.app) 308 → canonical.
# NEXT_PUBLIC_ENFORCE_CANONICAL_HOST=true

# Resend (https://resend.com) — create an API key in the dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 measurement ID (public; used client-side in production only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GVVP1SNKSJ

# Inbox that receives contact form submissions (defaults to site.email in code)
CONTACT_TO_EMAIL=your-inbox@gmail.com

# Sender shown in inbox. With onboarding@resend.dev, Resend often ONLY delivers
# TO the email address on your Resend account — verify a domain and set:
# RESEND_FROM="Portfolio <notifications@yourdomain.com>"
# RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
